# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bioscope_db?schema=public"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_ME"
NEXTAUTH_URL="http://localhost:3000"

# Uploadthing (https://uploadthing.com)
UPLOADTHING_SECRET="REPLACE_ME"
UPLOADTHING_APP_ID="REPLACE_ME"

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME="REPLACE_ME"
CLOUDINARY_API_KEY="REPLACE_ME"
CLOUDINARY_API_SECRET="REPLACE_ME"

# Socket.io standalone server
SOCKET_SERVER_URL="http://localhost:3001"
SOCKET_SERVER_PORT=3001
# Shared secret for the Next.js -> socket-server emit bridge.
# Defaults to NEXTAUTH_SECRET if unset. Set explicitly in production:
SOCKET_EMIT_SECRET="REPLACE_ME"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Email (configure one; optional in development)
SENDGRID_API_KEY="REPLACE_ME"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
RESEND_API_KEY="REPLACE_ME"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="REPLACE_ME"
SMTP_PASSWORD="REPLACE_ME"
SMTP_FROM_EMAIL="noreply@yourdomain.com"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Sticker Shop"

# Seeding (destructive! local DB only unless SEED_ALLOW_REMOTE=1)
# SEED_CONFIRM=yes
# SEED_ADMIN_PASSWORD=
# SEED_CUSTOMER_PASSWORD=
# SEED_ALLOW_REMOTE=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
