  },
  "shadow-ink-3": {
    "$type": "shadow",
    "$value": "6px 6px 0 var(--ink)",
    "$description": "Hard offset shadow, step 3"
  },
  "shadow-ink-4": {
    "$type": "shadow",
    "$value": "10px 10px 0 var(--ink)",
    "$description": "Hard offset shadow, step 4"
  },
  "shadow-color": {
    "$type": "shadow",
    "$value": "8px 8px 0 var(--accent)",
    "$description": "Colored offset shadow"
  },
  "shadow-die-cut": {
    "$type": "shadow",
    "$value": "0 0 0 3px var(--die-cut), var(--shadow-ink-2)",
