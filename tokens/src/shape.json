  },
  "radius-wobble-md": {
    "$type": "dimension",
    "$value": "18px 6px 20px 8px / 8px 20px 6px 18px",
    "$description": "Hand-drawn wobble outline, medium"
  },
  "radius-wobble-lg": {
    "$type": "dimension",
    "$value": "30px 10px 34px 12px / 12px 34px 10px 30px",
